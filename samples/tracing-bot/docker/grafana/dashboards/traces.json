{
  "annotations": { "list": [] },
  "description": "Distributed traces from the tracing-bot via Grafana Tempo. Shows all spans from the service plus focused views for bot-update and Kafka spans.",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 10,
      "title": "All Traces — tracing-bot service",
      "type": "row"
    },
    {
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 18, "w": 24, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "frameType": "TraceList"
      },
      "title": "All Traces (click a row to open the full trace flame-graph)",
      "description": "Every span from tracing-bot — Prometheus scrapes, actuator calls, Kafka consumer spans, and bot-update spans all appear here.",
      "type": "traces",
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"tracing-bot\" }",
          "limit": 100,
          "refId": "A",
          "tableType": "traces"
        }
      ]
    },
    {
      "collapsed": true,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 19 },
      "id": 11,
      "title": "Bot Update Traces — easygram.update  (requires Kafka producer + bot messages)",
      "type": "row",
      "panels": [
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "gridPos": { "h": 18, "w": 24, "x": 0, "y": 20 },
          "id": 2,
          "options": { "frameType": "TraceList" },
          "title": "easygram.update traces",
          "description": "Only populated after the bot processes a Telegram message. Start a Kafka producer sample and send a message to your bot.",
          "type": "traces",
          "targets": [
            {
              "datasource": { "type": "tempo", "uid": "tempo" },
              "queryType": "traceql",
              "query": "{ name = \"easygram.update\" }",
              "limit": 100,
              "refId": "A",
              "tableType": "traces"
            }
          ]
        }
      ]
    },
    {
      "collapsed": true,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 20 },
      "id": 12,
      "title": "Kafka Consumer Spans  (requires Kafka producer + bot messages)",
      "type": "row",
      "panels": [
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "gridPos": { "h": 16, "w": 24, "x": 0, "y": 21 },
          "id": 4,
          "options": { "frameType": "TraceList" },
          "title": "Kafka consumer spans",
          "type": "traces",
          "targets": [
            {
              "datasource": { "type": "tempo", "uid": "tempo" },
              "queryType": "traceql",
              "query": "{ name =~ \".*kafka.*\" || name =~ \".*receive.*\" }",
              "limit": 50,
              "refId": "A",
              "tableType": "traces"
            }
          ]
        }
      ]
    }
  ],
