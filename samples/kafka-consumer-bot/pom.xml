<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.4</version>
        <relativePath/>
    </parent>

    <groupId>uz.osoncode.easygram.samples</groupId>
    <artifactId>kafka-consumer-bot</artifactId>
    <version>0.0.5</version>
    <name>sample :: kafka-consumer-bot</name>
    <description>Sample: Bot that receives Telegram updates from a Kafka topic</description>

    <properties>
        <java.version>17</java.version>
        <library.version>0.0.5</library.version>
    </properties>

    <dependencies>
        <!-- Easygram messaging SPI (kafka + amqp are optional there; add them explicitly) -->
        <dependency>
            <groupId>uz.osoncode.easygram</groupId>
            <artifactId>messaging-api</artifactId>
            <version>${library.version}</version>
        </dependency>

        <!-- Required: Kafka driver — not transitively inherited because it is optional in messaging-api -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
