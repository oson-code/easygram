<?xml version="1.0" encoding="UTF-8"?>
<configuration>

  <!-- Inherit Spring Boot defaults (color support, system properties) -->
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <!--
        Pattern includes Easygram MDC fields injected by BotMdcFilter:
          bot.transport  — active transport (LONG_POLLING, WEBHOOK, KAFKA_CONSUMER, …)
          bot.update.id  — Telegram update ID (set per-update)
          bot.chat.id    — Telegram chat ID   (set per-update)
          bot.user.id    — Telegram user ID   (set per-update)
      -->
      <pattern>%clr(%d{HH:mm:ss.SSS}){faint} %clr(%-5level) %clr([%X{bot.transport:--} upd=%-8X{bot.update.id:--} chat=%X{bot.chat.id:--} user=%X{bot.user.id:--}]){cyan} %clr(%logger{36}){blue} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- Framework internals: DEBUG to observe dispatching, filter chain, and routing -->
  <logger name="uz.osoncode" level="DEBUG"/>
  <logger name="uz.example" level="DEBUG"/>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
  </root>

</configuration>
