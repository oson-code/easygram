# ─────────────────────────────────────────────────────────────────────────────
# Easygram producer-bot — environment variable reference
#
# Copy this file to .env and fill in the required values.
# All other properties use the defaults shown here.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────
# Telegram Bot API token issued by @BotFather.
easygram.token=


# ── Update transport ──────────────────────────────────────────────────────────
# LONG_POLLING (default) — no infrastructure needed; bot polls Telegram directly.
# WEBHOOK              — bot receives updates via HTTP POST from Telegram.
#easygram.update.transport=LONG_POLLING

# Required when transport=WEBHOOK: public HTTPS URL Telegram will POST updates to.
#easygram.update.webhook.url=https://example.com/webhook

# Local HTTP path receiving webhook requests. Default: /webhook
#easygram.update.webhook.path=/webhook

# Optional HMAC secret validated in X-Telegram-Bot-Api-Secret-Token header.
#easygram.update.webhook.secret-token=


# ── Broker selection ──────────────────────────────────────────────────────────
# KAFKA (default) or RABBIT
#easygram.messaging.producer.type=KAFKA

# Whether to skip local @BotController handlers after publishing. Default: true
#easygram.messaging.forward-only=true


# ── Kafka settings (active when producer.type=KAFKA) ─────────────────────────
# Kafka bootstrap servers. Default: kafka:9092 (matches compose service name).
#spring.kafka.bootstrap-servers=kafka:9092

# Topic to publish updates to. Default: easygram-updates
#easygram.messaging.kafka.topic=easygram-updates

# Auto-create topic on startup. Default: true
#easygram.messaging.kafka.create-if-absent=true

# Number of partitions when auto-creating. Default: 1
#easygram.messaging.kafka.partitions=1

# Replication factor when auto-creating. Default: 1
#easygram.messaging.kafka.replication-factor=1


# ── RabbitMQ settings (active when producer.type=RABBIT) ─────────────────────
# RabbitMQ host. Default: rabbitmq (matches compose service name).
#spring.rabbitmq.host=rabbitmq
#spring.rabbitmq.port=5672
#spring.rabbitmq.username=rabbit
#spring.rabbitmq.password=rabbit

# Exchange name. Default: easygram-exchange
#easygram.messaging.rabbit.exchange=easygram-exchange

# Queue name bound to the exchange. Default: easygram-updates
#easygram.messaging.rabbit.queue=easygram-updates

# Routing key. Default: easygram.updates
#easygram.messaging.rabbit.routing-key=easygram.updates

# Auto-create exchange, queue, and binding on startup. Default: true
#easygram.messaging.rabbit.create-if-absent=true
