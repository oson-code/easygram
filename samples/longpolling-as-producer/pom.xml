<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.4</version>
        <relativePath/>
    </parent>

    <groupId>uz.osoncode.easygram.samples</groupId>
    <artifactId>longpolling-as-producer</artifactId>
    <version>0.0.5</version>
    <name>sample :: longpolling-as-producer</name>
    <description>Sample: Long-polling bot that forwards every update to Kafka or RabbitMQ</description>

    <properties>
        <java.version>17</java.version>
        <library.version>0.0.5</library.version>
    </properties>

    <dependencies>
        <!-- spring-boot-starter pulls in longpolling, webhook, messaging-api and more -->
        <dependency>
            <groupId>uz.osoncode.easygram</groupId>
            <artifactId>spring-boot-starter</artifactId>
            <version>${library.version}</version>
        </dependency>

        <!-- Kafka driver — switch producer.type to KAFKA to use this -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!-- RabbitMQ driver — switch producer.type to RABBIT to use this -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
