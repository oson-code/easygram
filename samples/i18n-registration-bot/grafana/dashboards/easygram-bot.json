{
  "__inputs": [],
  "__requires": [
    { "type": "grafana",    "id": "grafana",    "name": "Grafana",    "version": "9.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "Easygram Telegram bot metrics — update throughput, latency, error rate and bot health.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [

    {
      "id": 1,
      "type": "stat",
      "title": "Total Updates",
      "description": "Total number of Telegram updates processed since the bot started.",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "blue",  "value": 1000 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(telegram_bot_update_seconds_count)",
          "instant": true,
          "legendFormat": "total"
        }
      ]
    },

    {
      "id": 2,
      "type": "stat",
      "title": "Update Rate (5 m)",
      "description": "Average number of updates per second over the last 5 minutes.",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red",    "value": 100 }
            ]
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(telegram_bot_update_seconds_count[5m]))",
          "instant": true,
          "legendFormat": "req/s"
        }
      ]
    },

    {
      "id": 3,
      "type": "stat",
      "title": "Avg Processing Time",
      "description": "Average handler processing time per update over the last 5 minutes.",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red",    "value": 2 }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(telegram_bot_update_seconds_sum[5m])) / sum(rate(telegram_bot_update_seconds_count[5m]))",
          "instant": true,
          "legendFormat": "avg"
        }
      ]
    },

    {
      "id": 4,
      "type": "stat",
      "title": "Bot Health",
      "description": "Telegram bot health status from /actuator/health. 1 = UP, 0 = DOWN/UNKNOWN.",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "options": { "0": { "color": "red",   "index": 0, "text": "DOWN"    } }, "type": "value" },
            { "options": { "1": { "color": "green", "index": 1, "text": "UP"      } }, "type": "value" },
            { "options": { "2": { "color": "yellow","index": 2, "text": "UNKNOWN" } }, "type": "value" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "green",  "value": 2 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "up{job=\"i18n-registration-bot\"}",
          "instant": true,
          "legendFormat": "health"
        }
      ]
    },

    {
      "id": 5,
      "type": "timeseries",
      "title": "Update Rate by Type",
      "description": "Updates per second grouped by update type (message, callback_query, inline_query, …).",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10, "gradientMode": "none" },
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (update_type) (rate(telegram_bot_update_seconds_count[5m]))",
          "legendFormat": "{{update_type}}"
        }
      ]
    },

    {
      "id": 6,
      "type": "timeseries",
      "title": "Processing Latency (P50 / P95 / P99)",
      "description": "Handler latency percentiles computed from the Micrometer histogram. Requires percentiles-histogram enabled in application.yml.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 5 },
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(telegram_bot_update_seconds_bucket[5m])))",
          "legendFormat": "P50"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(telegram_bot_update_seconds_bucket[5m])))",
          "legendFormat": "P95"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(telegram_bot_update_seconds_bucket[5m])))",
          "legendFormat": "P99"
        }
      ]
    },

    {
      "id": 7,
      "type": "timeseries",
      "title": "Error Rate",
      "description": "Updates that resulted in an error (exception thrown during handler execution), per second.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "red", "mode": "fixed" },
          "custom": { "lineWidth": 2, "fillOpacity": 20 },
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(telegram_bot_update_seconds_count{error!=\"none\",error!=\"\"}[5m]))",
          "legendFormat": "errors/s"
        }
      ]
    },

    {
      "id": 8,
      "type": "timeseries",
      "title": "Max Processing Time",
      "description": "Maximum observed processing time per scrape window (telegram_bot_update_seconds_max).",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "options": {
        "legend": { "calcs": ["max"], "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 5 },
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red",    "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max by (update_type) (telegram_bot_update_seconds_max)",
          "legendFormat": "{{update_type}}"
        }
      ]
    }

  ],
  "refresh": "30s",
  "schemaVersion": 37,
  "style": "dark",
  "tags": ["easygram", "telegram", "bot"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Easygram Bot",
  "uid": "easygram-bot",
  "version": 1
}
