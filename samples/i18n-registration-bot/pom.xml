<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>uz.osoncode.easygram.samples</groupId>
        <artifactId>samples-parent</artifactId>
        <version>0.0.6</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>i18n-registration-bot</artifactId>
    <name>sample :: i18n-registration-bot</name>
    <description>
        Sample: Multi-step registration wizard with full i18n support.
        Demonstrates LocalizedReply, LocalizedTemplate, BotMessageSource, BotKeyboardFactory,
        state management (@BotChatState / @BotForwardChatState / @BotClearChatState),
        and @BotTextPattern for phone-number routing.
        Supports English, Uzbek and Russian via Spring message bundles.
    </description>

    <dependencies>
        <dependency>
            <groupId>uz.osoncode.easygram</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- Actuator: /actuator/health, /actuator/info, /actuator/prometheus -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Prometheus metrics registry: exposes /actuator/prometheus for scraping -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
