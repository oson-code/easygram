<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>uz.osoncode.easygram</groupId>
        <artifactId>parent</artifactId>
        <version>0.0.1</version>
    </parent>

    <artifactId>messaging-producer</artifactId>
    <name>${project.groupId}:${project.artifactId}</name>
    <description>Auto-selecting broker publisher for the Easygram framework</description>
    <packaging>jar</packaging>

    <dependencies>

        <!--
            Both broker modules are included as regular (non-optional) dependencies so
            that adding messaging-producer is the only dependency a user ever needs.
            The active broker is selected purely by
            telegram.bot.messaging.producer.producer-type (kafka | rabbit);
            @ConditionalOnProperty ensures only the chosen broker's beans are created.
        -->
        <dependency>
            <groupId>uz.osoncode.easygram</groupId>
            <artifactId>messaging-kafka</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>uz.osoncode.easygram</groupId>
            <artifactId>messaging-rabbit</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>uz.osoncode.easygram</groupId>
            <artifactId>messaging-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

    </dependencies>
</project>
