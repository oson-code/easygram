<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>uz.osoncode.easygram</groupId>
        <artifactId>parent</artifactId>
        <version>0.0.3</version>
    </parent>

    <artifactId>messaging-kafka-consumer</artifactId>
    <name>${project.groupId}:${project.artifactId}</name>
    <description>Apache Kafka consumer transport for the Easygram framework</description>
    <packaging>jar</packaging>

    <dependencies>

        <dependency>
            <groupId>uz.osoncode.easygram</groupId>
            <artifactId>core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!--
            Marked provided: spring-kafka must be supplied by the user's project. It is not
            propagated transitively so projects that do not use the KAFKA_CONSUMER transport
            are never forced to add a Kafka broker dependency. Users who want the
            KAFKA_CONSUMER transport must add spring-kafka explicitly to their own project.
            @ConditionalOnClass(KafkaListener.class) ensures the autoconfiguration is skipped
            when the jar is absent.
        -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-observation</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

    </dependencies>
</project>
